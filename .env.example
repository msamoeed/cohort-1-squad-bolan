# Apps/api
PORT=3000
API_CORS_ORIGIN=http://localhost:3000
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-firebase-project-id.iam.gserviceaccount.com
# Preserve newline escapes (\n) when assigning this value.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Backblaze B2 / BlazeBucket object storage (native B2 API)
B2_BUCKET=your-bucket-name
B2_KEY_ID=your-key-id
B2_APPLICATION_KEY=your-application-key
# Optional helpers for clients / debugging
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
CDN_BASE_URL=https://f005.backblazeb2.com/file/your-bucket-name

# Gemini OCR (required for invoice extraction)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
